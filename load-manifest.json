{
  "defaults": {
    "all-tasks": {
      "description": "每次任务必载 — 宪法",
      "skills": ["CANON.md"]
    }
  },
  "phases": {
    "define": {
      "skills": ["define-brief"],
      "description": "视频任务定义"
    },
    "design": {
      "skills": ["design-title-cover", "design-script-beats", "design-storyboard", "design-styleframes"],
      "description": "标题封面、叙事节奏、分镜场景、静态关键帧"
    },
    "build": {
      "skills": ["build-web-motion"],
      "description": "Web 动画工程生成"
    },
    "verify": {
      "skills": ["verify-render-qa"],
      "description": "渲染质检与导出"
    }
  },
  "taskTypes": {
    "brief": {
      "description": "视频任务定义、brief",
      "detect": {
        "anyKeywords": ["brief", "视频任务", "任务定义", "做视频", "视频brief", "video brief", "视频", "video", "动画视频"]
      },
      "skills": ["define-brief"]
    },
    "title-cover": {
      "description": "标题封面设计、点击理由、视频承诺",
      "detect": {
        "anyKeywords": ["标题", "封面", "title", "cover", "点击理由", "视频承诺", "thumbnail"]
      },
      "skills": ["design-title-cover"]
    },
    "script-beats": {
      "description": "叙事节奏、脚本节奏点、旁白",
      "detect": {
        "anyKeywords": ["脚本", "script", "节奏", "beats", "叙事", "旁白", "narration", "hook"]
      },
      "skills": ["design-script-beats"]
    },
    "storyboard": {
      "description": "分镜、场景设计、时间轴",
      "detect": {
        "anyKeywords": ["分镜", "storyboard", "场景", "scene", "时间轴", "转场", "动效意图"]
      },
      "skills": ["design-storyboard"]
    },
    "styleframes": {
      "description": "静态关键帧、构图、视觉设计",
      "detect": {
        "anyKeywords": ["styleframe", "关键帧", "静态画面", "构图", "视觉设计", "色彩", "排版"]
      },
      "skills": ["design-styleframes"]
    },
    "web-motion": {
      "description": "Web 动画工程、GSAP、anime.js、HyperFrames",
      "detect": {
        "anyKeywords": ["compose", "动画工程", "GSAP", "anime.js", "web motion", "composition", "动画实现", "HyperFrames", "__timelines", "__hfAnime", "data-composition-id", "HyperFrames集成"]
      },
      "skills": ["build-web-motion"]
    },
    "render-qa": {
      "description": "渲染、质检、导出、QA",
      "detect": {
        "anyKeywords": ["render", "渲染", "质检", "QA", "导出", "export", "交付", "video export", "HyperFrames render", "视频导出"]
      },
      "skills": ["verify-render-qa"]
    },
    "audio": {
      "description": "音频集成、背景音乐、音效",
      "detect": {
        "anyKeywords": ["音频", "audio", "背景音乐", "bgm", "音效", "sound effect", "music"]
      },
      "skills": ["build-web-motion"]
    }
  },
  "context_signals": {
    "has_idea_no_brief": ["define-brief"],
    "has_brief_no_title": ["design-title-cover"],
    "has_title_no_script": ["design-script-beats"],
    "has_script_no_storyboard": ["design-storyboard"],
    "has_storyboard_no_styleframes": ["design-styleframes"],
    "has_styleframes_no_project": ["build-web-motion"],
    "has_project_no_render": ["verify-render-qa"],
    "has_audio_need_mix": ["build-web-motion"]
  },
  "checkpoints": {
    "checkpoint_1_title_cover": {
      "description": "标题封面确认 — 第 1 个人工确认点",
      "skills": ["design-title-cover"],
      "agents": ["title-cover-scout"]
    },
    "checkpoint_2_storyboard": {
      "description": "Storyboard 确认 — 第 2 个人工确认点",
      "skills": ["design-storyboard"],
      "agents": ["storyboard-reviewer", "styleframe-reviewer"]
    },
    "checkpoint_3_render_qa": {
      "description": "Render QA 确认 — 第 3 个人工确认点",
      "skills": ["verify-render-qa"],
      "agents": ["render-qa-auditor"]
    }
  },
  "skill_descriptions": {
    "define-brief": "有一个视频主题或想法需要结构化成可执行任务",
    "design-title-cover": "brief 已批准需要确定标题和封面的点击理由与承诺",
    "design-script-beats": "标题封面已批准需要拆解叙事节奏点",
    "design-storyboard": "script-beats 已批准需要把节奏点转成可执行场景",
    "design-styleframes": "storyboard 已批准需要设计每幕的静态关键帧",
    "build-web-motion": "storyboard + styleframes 已批准需要生成可渲染 Web 动画工程",
    "verify-render-qa": "Web 动画工程已完成需要渲染质检和导出"
  }
}
